# Greb — environment variables
# Copy to .env.local for local dev. Production/Preview values live ONLY in Vercel (separate per environment).
# Validated at boot by src/lib/env.ts (Zod). A variable becomes required in the milestone that first uses it
# (M0: APP_URL, DATABASE_URL; M1: BETTER_AUTH_SECRET; production also SENTRY_DSN, INNGEST_*, RESEND_API_KEY).
# Only NEXT_PUBLIC_* may reach the browser — never put secrets there.
# Limits/flags below are DEFAULTS; FeatureFlag / config rows in the DB override them at runtime (docs/02-arkitektur.md).

# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL (no trailing slash). Used in emails, Stripe redirects, certificate verify links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legal entity shown in email footers / receipts (name, CVR, address) — config, not hardcoded.
COMPANY_LEGAL_NAME="Mindforward (Esther Gruppen ApS)"
COMPANY_CVR=
COMPANY_ADDRESS=

# Server log level: debug | info | warn | error
LOG_LEVEL=info
# 1 = enable /api/debug/* routes (preview only; env validation forbids it in production)
ENABLE_DEBUG_ROUTES=0

# ─── Database (Neon Postgres, region aws-eu-central-1 / Frankfurt) ───
# Pooled connection string (PgBouncer, host contains "-pooler") — used at runtime via Prisma driver adapter.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/greb?sslmode=require
# Direct (unpooled) connection — used by prisma.config.ts for migrate/introspect (Prisma 7).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/greb?sslmode=require

# ─── Auth (Better Auth) ──────────────────────────────────────────────
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Microsoft Entra ID (app registration, redirect: {APP_URL}/api/auth/callback/microsoft — verify path at M1)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = any work/school (and personal) Microsoft account; "organizations" = work/school only. Decide in M1.
MICROSOFT_TENANT_ID=common
# Google OAuth (redirect: {APP_URL}/api/auth/callback/google — verify path at M1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic link validity in minutes
MAGIC_LINK_EXPIRES_MIN=15
# Stable production URL. OAuth redirect URIs are registered ONLY for this host; previews are proxied via
# Better Auth's oauth-proxy plugin. Set on Preview + Production (same value). Leave empty locally.
AUTH_PRODUCTION_URL=
# Shared by production and previews for the oauth-proxy payload encryption: `openssl rand -base64 32`
OAUTH_PROXY_SECRET=

# ─── Anthropic / AI gateway (src/server/ai/) ─────────────────────────
# Required in production unless AI_ENABLED=0.
ANTHROPIC_API_KEY=
# Kill switch (FeatureFlag row AI_ENABLED wins when present). 0 = chat answers "Øvemodellen holder pause".
AI_ENABLED=1
# Model ids ONLY here/config — never in code at call sites. Verify current ids + prices at project start.
# Default small model for sandbox chat, agent, support, grading. Empty = claude-haiku-4-5.
AI_MODEL_DEFAULT=claude-haiku-4-5
# Optional: separate grader model (defaults to AI_MODEL_DEFAULT). Changing it = new rubric baseline (golden set rerun).
AI_MODEL_GRADER=
# Fallback model used once after retries fail (sandbox/support only; grader never falls back). Empty = no fallback.
AI_MODEL_FALLBACK=
SUPPORT_MODEL=
# Content engine (docs/06-indholdsmotor.md): classify/draft small model; verify may be larger and MUST differ from draft.
CONTENT_CLASSIFY_MODEL=
CONTENT_DRAFT_MODEL=
CONTENT_VERIFY_MODEL=
# Per-user daily cap (Europe/Copenhagen day): tokens for chat/agent/assistants/automations/support (cache reads weighted 0.1).
AI_USER_DAILY_TOKEN_CAP=60000
# Per-user daily number of PROMPT_TASK gradings (separate so chat can't block module progress).
AI_USER_DAILY_GRADING_CAP=60
# Global monthly AI budget in DKK. Alert at 80 %, degraded mode at 95 %, block chat at 100 %. Target 5.000–10.000 kr at 10k users.
AI_GLOBAL_MONTHLY_BUDGET_DKK=5000
# Alert threshold (fraction) — exactly one alert per month.
AI_BUDGET_ALERT_PCT=0.8
# USD→DKK rate used to compute AiCall.costDkk from token prices (update monthly).
AI_USD_DKK_RATE=6.9
# 1 = mock all LLM calls (tests, e2e, offline dev). Never 1 in production.
AI_MOCK=0
AI_TIMEOUT_MS=30000

# ─── Module player (M4) — dev/e2e switches, all forbidden in production by env validation ───
# 1 = IN_REVIEW module versions are playable (core-prompt-01 stays IN_REVIEW until its golden set exists).
ALLOW_UNPUBLISHED_MODULES=0
# 1 = the PROMPT_TASK grader returns a fixed passing rubric result (no LLM call).
GRADER_MOCK=0
# 1 = every CLICK_TASK "Tjek" passes (no sandbox needed).
CLICK_TASK_MOCK=0

# ─── Content engine ──────────────────────────────────────────────────
# Fallback kill switches (FeatureFlag rows win). See docs/06-indholdsmotor.md § 11.
CONTENT_PIPELINE_ENABLED=false
CONTENT_AUTOPUBLISH_ENABLED=false
CONTENT_MONTHLY_BUDGET_DKK=300
CONTENT_RELEVANCE_THRESHOLD=0.6
# Honest crawler identity (docs/06 § 2)
CONTENT_USER_AGENT="GrebContentBot/1.0 (+https://example.com/bot; kontakt@example.com)"
# GitHub issues for UI/CORE changes (fine-grained PAT or GitHub App token with issues:write)
GITHUB_REPO=owner/greb
GITHUB_TOKEN=

# ─── Stripe (cards only; no Stripe Tax in MVP) ───────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Price ids per plan (docs/07-betaling.md). Amounts live in Stripe + config cross-check, never in components.
STRIPE_PRICE_B2C_MONTHLY=price_
# STRIPE_PRICE_B2C_ANNUAL is unused: no B2C annual plan in MVP (docs/00-beslutninger.md § 10a).
STRIPE_PRICE_B2C_ANNUAL=price_
STRIPE_PRICE_B2B_MONTHLY=price_
STRIPE_PRICE_B2B_ANNUAL=price_
# Manual Danish VAT (25 %) tax rates created by scripts/stripe-setup.ts
TAX_RATE_DK_25_INCLUSIVE=txr_
TAX_RATE_DK_25_EXCLUSIVE=txr_
# Stripe Customer Portal configuration id (Danish locale, cancel enabled)
STRIPE_PORTAL_CONFIGURATION_ID=bpc_
# 1 = in-process fake Stripe (tests, e2e, offline dev; no keys needed). Forbidden in production.
STRIPE_MOCK=0
# 1 = run Inngest-triggered jobs (billing) inline in the request instead of via Inngest (tests/e2e). Forbidden in production.
JOBS_INLINE=0

# ─── Email (Resend — sending domain created in region eu-west-1) ─────
RESEND_API_KEY=re_
# M8. Webhook signing secret (Svix headers) for bounce/complaint/delivery events → POST {APP_URL}/api/webhooks/resend
# (subscribe to email.delivered, email.bounced, email.complained). Without it the route answers 503.
RESEND_WEBHOOK_SECRET=whsec_
EMAIL_FROM_SERVICE="Mindforward <hej@mail.mindforward.dk>"
EMAIL_FROM_MARKETING="Mindforward <nyt@news.mindforward.dk>"
EMAIL_REPLY_TO=support@example.com
# Non-production: comma-separated addresses/domains allowed to receive mail; everything else is dropped + logged.
EMAIL_ALLOWLIST=
# resend | log | file. Default: resend when RESEND_API_KEY is set, otherwise log (prints mail in `pnpm dev`).
# `file` writes JSON to EMAIL_OUTBOX_DIR for Playwright. Production must use resend (env validation).
EMAIL_TRANSPORT=
EMAIL_OUTBOX_DIR=.e2e-outbox
# M5. HMAC secret for one-click unsubscribe tokens (/afmeld?t=…), ≥ 32 chars: `openssl rand -base64 32`.
# Optional at boot, but /afmeld shows "midlertidigt utilgængelig" without it → set it on Preview + Production.
UNSUBSCRIBE_TOKEN_SECRET=
# M5. Pepper for EmailSuppression.emailHash, ≥ 16 chars. Never change it once set (existing hashes would stop matching).
# The marketing gate fails closed (throws) without it.
EMAIL_HASH_PEPPER=
# Marketing kill switch fallback (FeatureFlag row MARKETING_EMAIL_ENABLED wins, cached ≤ 60 s).
# M8: marketing mails also need COMPANY_CVR + COMPANY_ADDRESS (sender in the footer) and UNSUBSCRIBE_TOKEN_SECRET.
MARKETING_EMAIL_ENABLED=false
# Owner digest + support escalations (M10). OWNER_DIGEST_EMAIL also receives the AI budget alerts (80 %/100 %).
# Without it the digest/alerts are skipped with a warning (the Escalation rows and BudgetMonth CAS still happen).
OWNER_DIGEST_EMAIL=
SUPPORT_INBOX=

# ─── Ads automation (only if enabled in docs/09; hard cap enforced in code) ───
ADS_AUTOMATION_ENABLED=false
ADS_MONTHLY_CAP_DKK=20000
ADS_MAX_CPL_DKK=
ADS_MIN_SPEND_FOR_DECISION_DKK=

# ─── Background jobs (Inngest) ───────────────────────────────────────
# Not needed locally with the Inngest Dev Server (INNGEST_DEV=1).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ─── Analytics (PostHog EU Cloud) — no analytics cookies before consent ───
# Empty (or the placeholder "phc_") = PostHog is never loaded. Before consent: persistence "memory" (no cookies,
# no local/sessionStorage); after "Accepter statistik": localStorage+cookie. No session replay, no autocapture.
NEXT_PUBLIC_POSTHOG_KEY=phc_
# EU ingestion host (verified M10). e2e builds point this at a same-origin path (requests are intercepted).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side events via posthog-node (same project key). Empty = server events are a no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Errors (Sentry, EU data region) ─────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development

# ─── Security ────────────────────────────────────────────────────────
# Secret used to hash join-link tokens, anonymous placement tokens, certificate codes (if signed)
TOKEN_HASH_SECRET=
# Optional bot protection on public placement test (only if abuse appears)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Storage (certificate PDFs, report exports) ──────────────────────
# Vercel Blob (verify EU data residency at M7; alternative: generate on demand, store nothing)
BLOB_READ_WRITE_TOKEN=

# ─── Phase 2 (not used in MVP) ───────────────────────────────────────
# e-conomic API for EAN invoicing (public customers)
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=

# Connector recommendations: CVR lookup (fixture = fictional CVR numbers in dev/test, erst = Erhvervsstyrelsen system-til-system, none = industry picker only)
CVR_PROVIDER=
CVR_ERST_USER=
CVR_ERST_PASSWORD=
