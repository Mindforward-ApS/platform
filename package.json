{
  "name": "greb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "content:validate": "tsx scripts/content-validate.ts",
    "sandbox:schema": "tsx scripts/sandbox-schema.ts",
    "postinstall": "prisma generate",
    "inngest:dev": "inngest-cli dev --no-discovery -u http://localhost:3000/api/inngest",
    "marketing:newsletter": "tsx --tsconfig scripts/tsconfig.cli.json scripts/send-newsletter.ts",
    "admin:grant": "tsx --conditions=react-server scripts/grant-admin.ts",
    "check:client-secrets": "tsx scripts/check-client-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@better-auth/prisma-adapter": "1.7.7",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.7",
    "inngest": "4.23.0",
    "next": "16.4.0",
    "node-html-parser": "9.0.4",
    "otplib": "13.5.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.9",
    "posthog-node": "^5.55.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "svix": "2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "inngest-cli": "^1.46.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  }
}
