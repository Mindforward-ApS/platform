// Greb — Prisma schema, M1 subset (auth, organisations, audit, email). Full spec: prisma/spec/schema.full.prisma.
// Remaining models are added in M2+ (docs/11-roadmap.md). Prisma 7, PostgreSQL on Neon AWS Frankfurt).
// Canonical entity names: docs/00-beslutninger.md §9. Field docs: docs/03-datamodel.md.
//
// Conventions
// - Tables are snake_case via @@map; columns keep Prisma camelCase (Better Auth reads Prisma field names).
// - Every org-owned row carries organizationId and every query filters on it (src/server/auth/scope.ts).
// - Money: integer øre (prices) or Decimal(12,4) DKK (AI/content cost). Never Float for money.
// - Prompt free text (StepResult.promptText/aiFeedback, SandboxEvent.contentText) is deleted after 30 days
//   by the Inngest job `retention.purge-prompt-text`. Admin queries must never select these fields.
//
// Prisma 7 notes (verify at project start):
// - datasource `url` lives in prisma.config.ts (DATABASE_URL_UNPOOLED for CLI/migrations).
// - Runtime client needs a driver adapter (@prisma/adapter-neon or @prisma/adapter-pg) with DATABASE_URL (pooled).
//
// Better Auth tables (User, Session, Account, Verification, TwoFactor, RateLimit, Organization, Membership,
// Invitation) follow the Better Auth core + organization plugin schema as documented 12 Oct 2026.
// TODO(M1): run `npx auth@latest generate` against this file and diff — Better Auth's CLI is the source of truth
// for its own fields. Organization plugin must be configured with schema.member.modelName = "membership"
// and custom roles named exactly OWNER | ADMIN | LEARNER (creatorRole: "OWNER") so writes match MembershipRole.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  BUSINESS
  PERSONAL
}

enum MembershipRole {
  OWNER
  ADMIN
  LEARNER
}

enum PlatformRole {
  USER
  GREB_ADMIN // internal operator (Marco); 2FA required
}

enum JobRole {
  SALES
  HR
  FINANCE
  CUSTOMER_SERVICE
  LEADERSHIP
  OPERATIONS
  OTHER
}

enum EmailCategory {
  SERVICE
  MARKETING
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED // blocked by consent gate or suppression list
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

enum ActorType {
  USER
  SYSTEM
  SUPPORT_AGENT
  CONTENT_ENGINE
  STRIPE_WEBHOOK
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth twoFactor plugin (required for GREB_ADMIN)
  twoFactorEnabled Boolean? @default(false)

  // Greb fields
  platformRole             PlatformRole @default(USER)
  locale                   String       @default("da")
  trainingRemindersEnabled Boolean      @default(true) // SERVICE reminders day 1/14/25 opt-out
  lastActiveAt             DateTime?
  deletionRequestedAt      DateTime? // GDPR erasure: hard-deleted by job within 30 days

  sessions             Session[]
  accounts             Account[]
  twoFactors           TwoFactor[]
  memberships          Membership[]
  invitationsSent      Invitation[]
  emailMessages        EmailMessage[]
  auditLogs            AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // organization plugin
  activeOrganizationId String?

  // Greb: GREB_ADMIN TOTP step-up for this session (requirePlatformAdmin). Better Auth's twoFactor plugin needs passwords.
  twoFactorVerifiedAt DateTime?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String // "credential" | "microsoft" | "google" | magic link uses Verification
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model Organization {
  // Better Auth organization plugin fields
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  // Greb fields (declared as additionalFields in the plugin config; all have defaults or are optional)
  updatedAt               DateTime         @updatedAt
  type                    OrganizationType @default(PERSONAL) // BUSINESS set explicitly on B2B create
  seatLimit               Int              @default(1) // = Subscription.quantity (webhook), trial: 5
  stripeCustomerId        String?          @unique
  billingEmail            String?
  cvr                     String?
  vatNumber               String? // EU B2B reverse charge (phase 2)
  ean                     String? // public customers (phase 2, e-conomic)
  country                 String           @default("DK")
  verifiedDomain          String?          @unique // domain join (M7)
  domainVerificationToken String?
  domainVerifiedAt        DateTime?
  joinLinkTokenHash       String?          @unique // invite-by-link (M7); store hash only
  joinLinkEnabled         Boolean          @default(false)
  dpaAcceptedAt           DateTime? // databehandleraftale (B2B)
  dpaVersion              String?
  deletedAt               DateTime? // soft delete → hard delete job after 30 days (legal records kept)

  members              Membership[]
  invitations          Invitation[]
  emailMessages        EmailMessage[]
  auditLogs            AuditLog[]

  @@index([type])
  @@map("organization")
}

model Membership {
  id             String         @id
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole @default(LEARNER)
  createdAt      DateTime       @default(now())

  // Greb fields
  updatedAt     DateTime  @updatedAt
  jobRole       JobRole? // drives ROLE modules
  deactivatedAt DateTime? // seat freed; data kept for org report until user deletion

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id             String          @id
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole? @default(LEARNER)
  status         String          @default("pending") // Better Auth: pending | accepted | rejected | canceled
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  inviterId      String
  inviter        User            @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("invitation")
}

model EmailMessage {
  id                String        @id @default(cuid())
  category          EmailCategory
  template          String // e.g. "service/reminder-day-14"
  templateVersion   String
  toEmail           String
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  consentRecordId   String? // REQUIRED by code when category = MARKETING
  idempotencyKey    String        @unique // e.g. "reminder:{monthlyAssignmentId}:14"
  resendId          String?       @unique
  status            EmailStatus   @default(QUEUED)
  subject           String
  sentAt            DateTime?
  deliveredAt       DateTime?
  lastEventAt       DateTime?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt


  @@index([userId, category])
  @@index([organizationId])
  @@index([status, createdAt])
  @@map("email_message")
}

model EmailSuppression {
  id               String            @id @default(cuid())
  emailHash        String            @unique // sha256(normalized email + EMAIL_HASH_PEPPER)
  reason           SuppressionReason
  appliesToService Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("email_suppression")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorType      ActorType
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String // typed union in src/server/audit/actions.ts, e.g. "MEMBER_ROLE_CHANGE", "MODULE_PUBLISH"
  targetType     String?
  targetId       String?
  metadata       Json? // never prompt text, never secrets
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}
