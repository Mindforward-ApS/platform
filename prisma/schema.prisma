// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth twoFactor plugin (required for GREB_ADMIN)
  twoFactorEnabled Boolean? @default(false)

  // Greb fields
  platformRole             PlatformRole @default(USER)
  locale                   String       @default("da")
  trainingRemindersEnabled Boolean      @default(true) // SERVICE reminders day 1/14/25 opt-out
  lastActiveAt             DateTime?
  deletionRequestedAt      DateTime? // GDPR erasure: hard-deleted by job within 30 days
  // Sign-up form (onboarding, Marco 11 Nov 2026). `name` keeps "Fornavn Efternavn" for Better Auth and emails.
  firstName                String?
  lastName                 String?
  phone                    String? // E.164, e.g. +4512345678

  sessions                Session[]
  accounts                Account[]
  twoFactors              TwoFactor[]
  memberships             Membership[]
  invitationsSent         Invitation[]
  assignments             Assignment[]             @relation("AssignmentLearner")
  assignmentsCreated      Assignment[]             @relation("AssignmentAssigner")
  attempts                Attempt[]
  certificates            Certificate[]
  courseLessonCompletions CourseLessonCompletion[]
  monthlyAssignments      MonthlyAssignment[]
  placementResults        PlacementResult[]
  consentRecords          ConsentRecord[]
  emailMessages           EmailMessage[]
  supportConversations    SupportConversation[]
  escalations             Escalation[]             @relation("EscalationUser")
  escalationsResolved     Escalation[]             @relation("EscalationResolver")
  auditLogs               AuditLog[]
  sandboxSessions         SandboxSession[]
  sandboxEvents           SandboxEvent[]
  aiUsageDaily            AiUsageDaily[]
  aiCalls                 AiCall[]
  withdrawalRequests      WithdrawalRequest[]
  trackEnrollments        TrackEnrollment[]
  credentialTransfers     CredentialTransfer[]
  certificateShares       CertificateShare[]
  workProfiles            WorkProfile[]
  connectorDemoRuns       ConnectorDemoRun[]
  onboardingProfiles      OnboardingProfile[]
  calendarEvents          CalendarEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // organization plugin
  activeOrganizationId String?

  // Greb: GREB_ADMIN TOTP step-up for this session (requirePlatformAdmin). Better Auth's twoFactor plugin needs passwords.
  twoFactorVerifiedAt DateTime?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String // "credential" | "microsoft" | "google" | magic link uses Verification
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth twoFactor plugin. TODO(M1): verify fields with `npx auth@latest generate`.
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

/// Rate-limit counters (Better Auth `rateLimit.storage = "database"` + our own limiter in src/server/security/rate-limit.ts).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ───────────────────────────── Organizations ─────────────────────────────

model Organization {
  // Better Auth organization plugin fields
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  // Greb fields (declared as additionalFields in the plugin config; all have defaults or are optional)
  updatedAt               DateTime         @updatedAt
  type                    OrganizationType @default(PERSONAL) // BUSINESS set explicitly on B2B create
  seatLimit               Int              @default(1) // = Subscription.quantity (webhook), trial: 5
  stripeCustomerId        String?          @unique
  billingEmail            String?
  cvr                     String?
  vatNumber               String? // EU B2B reverse charge (phase 2)
  ean                     String? // public customers (phase 2, e-conomic)
  country                 String           @default("DK")
  verifiedDomain          String?          @unique // domain join (M7)
  domainVerificationToken String?
  domainVerifiedAt        DateTime?
  joinLinkTokenHash       String?          @unique // invite-by-link (M7); store hash only
  joinLinkEnabled         Boolean          @default(false)
  aiPolicyUrl             String? // link to the customer's own AI policy (docs/01 V5)
  defaultTrackId          String?
  defaultTrack            Track?           @relation("OrgDefaultTrack", fields: [defaultTrackId], references: [id], onDelete: SetNull)
  defaultLicenseTier      LicenseTier?
  dpaAcceptedAt           DateTime? // databehandleraftale (B2B)
  dpaVersion              String?
  deletedAt               DateTime? // soft delete → hard delete job after 30 days (legal records kept)

  members                 Membership[]
  invitations             Invitation[]
  subscriptions           Subscription[]
  assignments             Assignment[]
  attempts                Attempt[]
  certificates            Certificate[]
  courseLessonCompletions CourseLessonCompletion[]
  monthlyAssignments      MonthlyAssignment[]
  placementResults        PlacementResult[]
  emailMessages           EmailMessage[]
  supportConversations    SupportConversation[]
  escalations             Escalation[]
  auditLogs               AuditLog[]
  sandboxSessions         SandboxSession[]
  withdrawalRequests      WithdrawalRequest[]
  trackEnrollments        TrackEnrollment[]
  credentialTransfersIn   CredentialTransfer[]
  certificateShares       CertificateShare[]
  workProfiles            WorkProfile[]
  connectorDemoRuns       ConnectorDemoRun[]
  onboardingProfiles      OnboardingProfile[]
  calendarEvents          CalendarEvent[]

  @@index([type])
  @@map("organization")
}

/// Better Auth `member` table, renamed via schema.member.modelName = "membership".
model Membership {
  id             String         @id
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole @default(LEARNER)
  createdAt      DateTime       @default(now())

  // Greb fields
  updatedAt     DateTime  @updatedAt
  jobRole       JobRole? // drives ROLE modules
  deactivatedAt DateTime? // seat freed; data kept for org report until user deletion

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

/// Better Auth invitation (email invites). Link/domain join live on Organization.
model Invitation {
  id             String          @id
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole? @default(LEARNER)
  status         String          @default("pending") // Better Auth: pending | accepted | rejected | canceled
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  inviterId      String
  inviter        User            @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  // Greb: what the invitee gets on accept (docs/01 § 4.2.3)
  trackId     String?
  track       Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  jobRole     JobRole?
  licenseTier LicenseTier?

  @@index([organizationId, status])
  @@index([email])
  @@map("invitation")
}

// ───────────────────────────── Billing ─────────────────────────────

/// DB mirror of src/lib/config/plans.ts (docs/07-betaling.md). Amount shown to users comes from the Stripe Price;
/// unitAmountOre = expectedUnitAmountOre cross-check. Never hardcode prices in components.
model Plan {
  id            String          @id @default(cuid())
  code          String          @unique // B2C_MONTHLY | B2C_ANNUAL | B2B_MONTHLY | B2B_ANNUAL (FREE has no row)
  audience      PlanAudience
  interval      BillingInterval
  unitAmountOre Int // 4900 = 49 kr
  currency      String          @default("dkk")
  taxBehavior   TaxBehavior
  minSeats      Int             @default(1) // B2B: 5
  trialDays     Int             @default(0) // B2B: 14
  trialMaxSeats Int? // B2B: 5
  stripePriceId String?         @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subscriptions Subscription[]

  @@map("plan")
}

/// Mirror of a Stripe subscription. Written ONLY by the Stripe webhook handler.
/// Max ONE non-terminal subscription per organization: enforced in code + partial unique index added by hand
/// in the migration (Prisma cannot express it):
///   CREATE UNIQUE INDEX subscription_one_open_per_org ON subscription ("organizationId")
///   WHERE status NOT IN ('CANCELED','INCOMPLETE_EXPIRED');
model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String?
  plan                 Plan?              @relation(fields: [planId], references: [id])
  planKey              String // plan key from config (B2C_MONTHLY …), resolved from Stripe price id
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  stripePriceId        String
  status               SubscriptionStatus
  quantity             Int                @default(1)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  endedAt              DateTime?
  lastStripeEventAt    DateTime // ignore out-of-order events older than this
  lastStripeEventId    String

  // Consumer-law (B2C) — copied from Checkout Session metadata set server-side before redirect
  immediateAccessConsentAt        DateTime? // "Jeg ønsker adgang straks …" checkbox
  withdrawalWaiverAcknowledgedAt  DateTime? // erkendelse: fortrydelsesret bortfalder/begrænses
  withdrawalConsentTextVersion    String? // e.g. "withdrawal-consent.v1"
  withdrawalDeadlineAt            DateTime? // purchase + 14 days → "Fortryd aftale" button visible until then
  orderConfirmationEmailMessageId String? // durable-medium confirmation (EmailMessage.id)
  cancellationRequestedInAppAt    DateTime? // § 28 a: in-app cancellation

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  withdrawalRequests WithdrawalRequest[]

  @@index([organizationId, status])
  @@map("subscription")
}

/// "Fortryd aftale" (forbrugeraftaleloven § 20 a). Kept 5 years as evidence.
model WithdrawalRequest {
  id                    String           @id @default(cuid())
  organizationId        String?
  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscriptionId        String?
  subscription          Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  email                 String
  agreementReference    String // which agreement (plan + order date / subscription id)
  submittedAt           DateTime // "Bekræft fortrydelse" click = receipt timestamp
  ip                    String?
  userAgent             String?
  status                WithdrawalStatus @default(RECEIVED)
  receiptEmailMessageId String?          @unique
  receiptEmailMessage   EmailMessage?    @relation(fields: [receiptEmailMessageId], references: [id], onDelete: SetNull)
  receiptSentAt         DateTime?
  refundAmountOre       Int?
  stripeRefundId        String?
  processedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([organizationId])
  @@index([status, submittedAt])
  @@map("withdrawal_request")
}

// ───────────────────────────── Curriculum ─────────────────────────────

model Track {
  id           String        @id @default(cuid())
  key          TrackKey      @unique
  displayName  String // descriptive only, e.g. "Microsoft 365 Copilot"
  vendorName   String // "Microsoft" — used in disclaimer copy only
  skinKey      String // content/sandbox-skins/<skinKey>.json
  isActive     Boolean       @default(false) // MVP: CHATGPT + COPILOT + CLAUDE
  sortOrder    Int           @default(0)
  licenseTiers LicenseTier[] @default([]) // COPILOT: [COPILOT_CHAT, COPILOT_M365]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  modules          ModuleTrack[]
  invitations      Invitation[]
  defaultForOrgs   Organization[]    @relation("OrgDefaultTrack")
  certificates     Certificate[]
  monthlyCycles    MonthlyCycle[]
  placementResults PlacementResult[]
  contentSources   ContentSource[]
  sandboxSessions  SandboxSession[]
  enrollments      TrackEnrollment[]
  courses          Course[]
  onboardingProfiles OnboardingProfile[]

  @@map("track")
}

model Module {
  id                 String         @id @default(cuid())
  slug               String         @unique // = module JSON "id", e.g. "core-prompt-01"
  tracks             ModuleTrack[] // a CORE module runs on several tracks (§ 10a)
  type               ModuleType
  jobRole            JobRole? // only for type ROLE
  requiredLicense    LicenseTier? // denormalized from published version (module JSON requiresTier)
  sortOrder          Int            @default(0) // curriculum order; "first 3 free" is computed from config + order
  publishedVersionId String?        @unique
  publishedVersion   ModuleVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  isStale            Boolean        @default(false) // freshness audit flag
  retiringAt         DateTime? // feature-registry retire date → banner
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  versions     ModuleVersion[]     @relation("ModuleVersions")
  assignments  Assignment[]
  refresherFor MonthlyAssignment[]

  @@index([type])
  @@map("module")
}

/// Which tracks a module belongs to (module JSON `tracks`). Replaces the single Module.trackId from the spec (§ 10a).
model ModuleTrack {
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track  @relation(fields: [trackId], references: [id])

  @@id([moduleId, trackId])
  @@index([trackId])
  @@map("module_track")
}

/// Immutable once PUBLISHED. Steps live in `content` (JSON validated by content/schema/module.schema.json).
model ModuleVersion {
  id               String              @id @default(cuid())
  moduleId         String
  module           Module              @relation("ModuleVersions", fields: [moduleId], references: [id], onDelete: Cascade)
  version          Int
  status           ModuleVersionStatus @default(DRAFT)
  origin           ModuleOrigin        @default(MANUAL)
  schemaVersion    String // module.schema.json version
  title            String
  content          Json // full module JSON incl. steps, rubrics, sourceRefs
  maxPoints        Int
  estimatedMinutes Int
  requiredLicense  LicenseTier?
  featureRefs      String[]            @default([]) // content/features/registry.json ids
  searchText       String              @db.Text // denormalized text for alias ILIKE (impact analysis)
  contentHash      String // sha256 of canonical JSON

  // Content-engine provenance (origin = AUTO)
  changeEventId  String?
  changeEvent    ChangeEvent? @relation(fields: [changeEventId], references: [id], onDelete: SetNull)
  pipelineRunId  String?
  pipelineRun    PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  draftAttempt   Int          @default(0)
  promptVersions Json? // { draft: "content-draft.v1", verify: "content-verify.v1" }
  modelIds       Json?
  verifyReport   Json?

  publishedAt   DateTime?
  publishedById String? // User.id or null for auto-publish
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  publishedIn     Module?          @relation("PublishedVersion")
  attempts        Attempt[]
  sandboxSessions SandboxSession[]

  @@unique([moduleId, version])
  @@unique([changeEventId, draftAttempt])
  @@index([status, origin])
  @@index([pipelineRunId])
  @@map("module_version")
}

// ───────────────────────────── Learning ─────────────────────────────

/// A learner's chosen track (+ Copilot license level). Drives plan, monthly package and license filtering.
model TrackEnrollment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId        String
  track          Track        @relation(fields: [trackId], references: [id])
  licenseTier    LicenseTier? // COPILOT only; null = not asked / not relevant
  level          Int          @default(0) // from latest PlacementResult
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId, trackId])
  @@index([trackId, active])
  @@map("track_enrollment")
}

/// Privat membership chosen in onboarding (Marco 11 Nov 2026). Only SINGLE has Stripe billing today (B2C_MONTHLY).
enum PersonalPlanChoice {
  SINGLE // Enkelt bruger
  FRIEND // Med en ven
  STUDENT // Studerende eller jobsøgende
}

/// Erhverv team size chosen in onboarding.
enum TeamSizeBand {
  SIZE_1_9
  SIZE_10_PLUS
  ENTERPRISE
}

enum OnboardingStartPath {
  PLACEMENT_TEST // Tag niveautesten
  FROM_SCRATCH // Start fra bunden
}

/// Answers from the sign-up onboarding, per user per organization, so the platform can personalise.
/// The track itself also lives in TrackEnrollment and the test result in PlacementResult.
model OnboardingProfile {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personalPlan   PersonalPlanChoice? // Privat only
  friendEmail    String? // FRIEND: the friend to invite (no billing support yet)
  studentEmail   String? // STUDENT: proof by study mail (upload not built yet)
  teamSizeBand   TeamSizeBand? // Erhverv (OWNER) only
  startPath      OnboardingStartPath?
  trackId        String?
  track          Track?               @relation(fields: [trackId], references: [id], onDelete: SetNull)
  completedAt    DateTime? // set when "Din plan er klar" is shown
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("onboarding_profile")
}

model PlacementResult {
  id                   String        @id @default(cuid())
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  anonymousTokenHash   String?       @unique // public lead-magnet test before signup (cookie token, hashed)
  trackId              String
  track                Track         @relation(fields: [trackId], references: [id])
  licenseTier          LicenseTier? // Copilot level asked in the test
  jobRole              JobRole?
  testVersion          String
  answers              Json // option ids only — no free text
  scorePct             Decimal       @db.Decimal(5, 2)
  level                Int
  recommendedModuleIds String[]      @default([])
  durationSeconds      Int?
  claimedAt            DateTime? // anonymous result attached to a new account
  createdAt            DateTime      @default(now())

  @@index([userId, trackId, createdAt])
  @@index([organizationId])
  @@map("placement_result")
}

model Assignment {
  id                      String           @id @default(cuid())
  organizationId          String
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User             @relation("AssignmentLearner", fields: [userId], references: [id], onDelete: Cascade)
  moduleId                String
  module                  Module           @relation(fields: [moduleId], references: [id])
  source                  AssignmentSource
  assignedById            String?
  assignedBy              User?            @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  sortOrder               Int              @default(0)
  status                  AssignmentStatus @default(ASSIGNED)
  dueAt                   DateTime?
  bestAttemptId           String?
  bestScorePct            Decimal?         @db.Decimal(5, 2)
  passedAt                DateTime?
  carriedFromAssignmentId String? // source = CARRIED_OVER: the passed assignment in the learner's other account (no FK; that org may be deleted)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  attempts Attempt[]

  @@unique([organizationId, userId, moduleId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("assignment")
}

model Attempt {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId    String?
  assignment      Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  moduleVersionId String
  moduleVersion   ModuleVersion @relation(fields: [moduleVersionId], references: [id])
  status          AttemptStatus @default(IN_PROGRESS)
  points          Int           @default(0)
  maxPoints       Int
  scorePct        Decimal?      @db.Decimal(5, 2)
  passed          Boolean       @default(false)
  mustPassFailed  Boolean       @default(false) // data-security JUDGMENT failed → not passed regardless of %
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  stepResults     StepResult[]
  sandboxSessions SandboxSession[]

  @@index([userId, moduleVersionId])
  @@index([organizationId, completedAt])
  @@index([assignmentId])
  @@map("attempt")
}

model StepResult {
  id                    String        @id @default(cuid())
  attemptId             String
  attempt               Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stepId                String // step id inside ModuleVersion.content
  stepType              StepType
  points                Int           @default(0)
  maxPoints             Int
  passed                Boolean       @default(false)
  hintLevelUsed         Int           @default(0) // 0–3; 3 = solution shown → 0 points
  tryCount              Int           @default(1)
  answer                Json? // structured answers only (option ids, spot-error selection) — never free text
  gradingStatus         GradingStatus @default(GRADED)
  checksReport          Json? // deterministic PROMPT_TASK checks (ids + pass/fail)
  rubricScores          Json? // [{ criterionId, met, points }] — no quotes of the learner's text
  rubricVersion         String?
  modelId               String?
  promptVersion         String?
  matchedSandboxEventId String? // CLICK_TASK: the SandboxEvent that satisfied the assertion
  flags                 Json? // statistics only, e.g. { fastAnswer: true } (docs/05 § 7) — no sanctions

  // Free text — owner-only, purged after 30 days (retention.purge-prompt-text)
  promptText         String?   @db.Text
  aiFeedback         String?   @db.Text
  promptTextPurgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, stepId])
  @@index([createdAt]) // retention scan
  @@map("step_result")
}

model Certificate {
  id                        String             @id @default(cuid())
  verificationCode          String             @unique // public verify URL /certifikat/<code>
  userId                    String
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId            String
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackId                   String
  track                     Track              @relation(fields: [trackId], references: [id])
  level                     Int
  levelLabel                String // snapshot of the label at issue time
  licenseTier               LicenseTier?
  holderName                String // snapshot
  moduleVersionIds          String[]           @default([]) // evidence snapshot
  pdfStorageKey             String?
  contentVersion            String // curriculum/content version shown on the certificate
  publicVerificationEnabled Boolean            @default(false) // opt-in by the learner (GDPR art. 25, § 10a)
  issuedAt                  DateTime           @default(now())
  revokedAt                 DateTime?
  shares                    CertificateShare[]

  @@unique([userId, organizationId, trackId, level])
  @@index([organizationId])
  @@map("certificate")
}

/// One per (calendar month, track): the NEWS package shared by all learners on that track.
model MonthlyCycle {
  id         String   @id @default(cuid())
  month      String // "2026-11"
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id])
  moduleIds  String[] @default([]) // NEWS modules (ordered)
  composedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments MonthlyAssignment[]

  @@unique([month, trackId])
  @@map("monthly_cycle")
}

/// Personal monthly package: cycle NEWS modules filtered by license tier + 1 refresher. Target ≤ 15 min.
model MonthlyAssignment {
  id                  String                  @id @default(cuid())
  cycleId             String
  cycle               MonthlyCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleIds           String[]                @default([])
  refresherModuleId   String?
  refresherModule     Module?                 @relation(fields: [refresherModuleId], references: [id], onDelete: SetNull)
  estimatedMinutes    Int
  status              MonthlyAssignmentStatus @default(PENDING)
  completedAt         DateTime?
  reminderDay1SentAt  DateTime?
  reminderDay14SentAt DateTime?
  reminderDay25SentAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([cycleId, userId, organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("monthly_assignment")
}

// ───────────────────────────── Content engine ─────────────────────────────

model ContentSource {
  id                 String       @id @default(cuid())
  key                String       @unique // content/sources.json key
  trackId            String
  track              Track        @relation(fields: [trackId], references: [id])
  url                String
  parserType         ParserType
  parserVersion      String
  fetchMode          FetchMode    @default(DIRECT)
  status             SourceStatus @default(ACTIVE)
  enabled            Boolean      @default(true) // per-source kill switch
  autoPublishAllowed Boolean      @default(true)
  attribution        String? // e.g. "Microsoft Learn, CC BY 4.0"
  etag               String?
  lastModified       String?
  lastFetchedAt      DateTime?
  lastSuccessAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  snapshots    SourceSnapshot[]
  changeEvents ChangeEvent[]
  pipelineRuns PipelineRun[]

  @@map("content_source")
}

model SourceSnapshot {
  id            String         @id @default(cuid())
  sourceId      String
  source        ContentSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fetchedAt     DateTime
  httpStatus    Int
  etag          String?
  origin        SnapshotOrigin
  parserVersion String
  contentHash   String
  raw           Bytes? // gzip; purged after 90 days
  rawPurgedAt   DateTime?
  entries       Json // ParsedEntry[] — kept while a PUBLISHED module cites it
  createdAt     DateTime       @default(now())

  changeEvents ChangeEvent[]

  @@unique([sourceId, contentHash])
  @@index([sourceId, fetchedAt])
  @@map("source_snapshot")
}

model ChangeEvent {
  id                String            @id @default(cuid())
  sourceId          String
  source            ContentSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshotId        String
  snapshot          SourceSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  pipelineRunId     String?
  pipelineRun       PipelineRun?      @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  entryKey          String
  entryHash         String
  entryDate         DateTime?
  title             String
  text              String            @db.Text
  previousText      String?           @db.Text
  kind              ChangeKind
  status            ChangeEventStatus @default(NEW)
  changeType        String? // classify output (FEATURE | DEPRECATION | RETIREMENT | …) — see docs/06
  relevance         Float?
  classification    Json?
  affectedModuleIds String[]          @default([])
  githubIssueUrl    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  moduleVersions ModuleVersion[]

  @@unique([sourceId, entryKey, entryHash])
  @@index([status])
  @@map("change_event")
}

model PipelineRun {
  id             String            @id @default(cuid())
  kind           PipelineRunKind
  sourceId       String?
  source         ContentSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  idempotencyKey String            @unique // "{sourceId}:{yyyy-mm-dd}" | "freshness:{isoWeek}"
  status         PipelineRunStatus @default(RUNNING)
  steps          Json? // per-step status/timing/errors
  tokensIn       Int               @default(0)
  tokensOut      Int               @default(0)
  costDkk        Decimal           @default(0) @db.Decimal(12, 4)
  promptVersions Json?
  modelIds       Json?
  verifyReport   Json?
  error          String?           @db.Text
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?

  changeEvents   ChangeEvent[]
  moduleVersions ModuleVersion[]

  @@index([kind, startedAt])
  @@index([sourceId, startedAt])
  @@map("pipeline_run")
}

// ───────────────────────────── Email & consent ─────────────────────────────

/// Consent evidence — APPEND-ONLY. The latest row per (subjectEmail, purpose, channel) is the current state.
/// Marketing gate: latest row must be action = CONFIRMED (docs/09-email-og-marketing.md § 2.1).
/// Checkout declarations: two GRANTED rows (IMMEDIATE_ACCESS_REQUEST, WITHDRAWAL_LOSS_ACK) written BEFORE payment.
/// confirmedAt / withdrawnAt are denormalized onto the GRANTED row for fast lookups; the action rows are the evidence.
model ConsentRecord {
  id                    String          @id @default(cuid())
  userId                String?
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId        String?
  subjectEmail          String // normalized: lowercase + trim
  channel               ConsentChannel  @default(EMAIL)
  purpose               ConsentPurpose
  action                ConsentAction
  grantId               String? // CONFIRMED/WITHDRAWN rows point to the GRANTED row they act on
  grant                 ConsentRecord?  @relation("ConsentGrant", fields: [grantId], references: [id], onDelete: SetNull)
  followUps             ConsentRecord[] @relation("ConsentGrant")
  textVersion           String // e.g. "marketing-consent.v1" (content/legal/)
  textHash              String // sha256 of the exact text shown
  source                ConsentSource
  ip                    String?
  userAgent             String?
  checkoutSessionId     String? // checkout declarations only
  confirmationTokenHash String?         @unique // double opt-in token (hash), on GRANTED row; expires after 7 days
  confirmationSentAt    DateTime?
  confirmedAt           DateTime? // double opt-in completed (set on GRANTED row)
  withdrawnAt           DateTime? // withdrawn (set on GRANTED row)
  createdAt             DateTime        @default(now()) // = timestamp of this action

  emailMessages EmailMessage[]

  @@index([subjectEmail, purpose, channel, createdAt])
  @@index([userId])
  @@index([checkoutSessionId])
  @@map("consent_record")
}

model EmailMessage {
  id              String         @id @default(cuid())
  category        EmailCategory
  template        String // e.g. "service/reminder-day-14"
  templateVersion String
  toEmail         String
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  consentRecordId String? // REQUIRED by code when category = MARKETING
  consentRecord   ConsentRecord? @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)
  idempotencyKey  String         @unique // e.g. "reminder:{monthlyAssignmentId}:14"
  resendId        String?        @unique
  status          EmailStatus    @default(QUEUED)
  subject         String
  sentAt          DateTime?
  deliveredAt     DateTime?
  lastEventAt     DateTime?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  withdrawalReceipt WithdrawalRequest?

  @@index([userId, category])
  @@index([organizationId])
  @@index([status, createdAt])
  @@map("email_message")
}

/// Suppression list, checked before every send. Stores only a hash of the normalized email.
/// UNSUBSCRIBED/COMPLAINT block MARKETING; HARD_BOUNCE also blocks SERVICE except security/login mails to a new address.
model EmailSuppression {
  id               String            @id @default(cuid())
  emailHash        String            @unique // sha256(normalized email + EMAIL_HASH_PEPPER)
  reason           SuppressionReason
  appliesToService Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("email_suppression")
}

// ───────────────────────────── Support ─────────────────────────────

model SupportConversation {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         SupportConversationStatus @default(OPEN)
  promptVersion  String
  modelId        String
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  messages    SupportMessage[]
  escalations Escalation[]

  @@index([userId, lastMessageAt])
  @@index([organizationId])
  @@map("support_conversation")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           SupportMessageRole
  content        String              @db.Text
  toolName       String?
  toolInput      Json?
  toolResult     Json?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_message")
}

model Escalation {
  id               String               @id @default(cuid())
  conversationId   String?
  conversation     SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?                @relation("EscalationUser", fields: [userId], references: [id], onDelete: SetNull)
  organizationId   String?
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reason           EscalationReason
  priority         EscalationPriority   @default(NORMAL)
  summary          String               @db.Text
  status           EscalationStatus     @default(OPEN)
  resolvedById     String?
  resolvedBy       User?                @relation("EscalationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  digestIncludedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, priority, createdAt])
  @@map("escalation")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorType      ActorType
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String // typed union in src/server/audit/actions.ts, e.g. "MEMBER_ROLE_CHANGE", "MODULE_PUBLISH"
  targetType     String?
  targetId       String?
  metadata       Json? // never prompt text, never secrets
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ───────────────────────────── Sandbox ─────────────────────────────

model SandboxSession {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackId         String
  track           Track                @relation(fields: [trackId], references: [id])
  skinKey         String
  worldVersion    String // content/sandbox-world version used for this session
  moduleVersionId String?
  moduleVersion   ModuleVersion?       @relation(fields: [moduleVersionId], references: [id], onDelete: SetNull)
  sceneId         String? // content/sandbox-world/scenes/<sceneId>.json applied at start (step `scene`)
  attemptId       String?
  attempt         Attempt?             @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  state           Json // overlay on seed world: connectors, automations, assistants, drafts, edits
  nextSeq         Int                  @default(1)
  status          SandboxSessionStatus @default(ACTIVE)
  lastActivityAt  DateTime             @default(now())
  expiresAt       DateTime // idle sessions closed after 7 days
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  events SandboxEvent[]

  @@index([userId, status])
  @@index([attemptId])
  @@index([organizationId])
  @@map("sandbox_session")
}

model SandboxEvent {
  id              String           @id @default(cuid())
  sessionId       String
  session         SandboxSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  seq             Int // monotonically increasing per session (server-assigned)
  type            SandboxEventType
  actor           String           @default("USER") // USER | MODEL | AUTOMATION | SYSTEM
  target          String? // stable UI/object target, e.g. "nav.newChat", "mail:m08" (Predicate `target`, docs/05 § 3)
  payload         Json // Zod-validated per type; NO free text here
  contentText     String?          @db.Text // free text (chat prompt/reply, drafts) — purged after 30 days
  contentPurgedAt DateTime?
  stepId          String? // module step active when emitted
  createdAt       DateTime         @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, type])
  @@index([organizationId, createdAt])
  @@index([createdAt]) // retention scan
  @@map("sandbox_event")
}

// ───────────────────────────── AI usage & budgets ─────────────────────────────

/// Per-user daily ledger used to enforce AI_USER_DAILY_TOKEN_CAP (Europe/Copenhagen day).
model AiUsageDaily {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day              DateTime @db.Date
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  callCount        Int      @default(0)
  costDkk          Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt        DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
  @@map("ai_usage_daily")
}

/// One row per LLM call (no prompt/response text). Kept 13 months.
model AiCall {
  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId    String?
  feature           AiFeature
  model             String
  promptKey         String // e.g. "sandbox-chat"
  promptVersion     String // e.g. "v3"
  inputTokens       Int          @default(0)
  outputTokens      Int          @default(0)
  cacheReadTokens   Int          @default(0)
  cacheWriteTokens  Int          @default(0)
  costDkk           Decimal      @default(0) @db.Decimal(12, 4)
  latencyMs         Int?
  status            AiCallStatus
  errorCode         String?
  providerRequestId String?
  createdAt         DateTime     @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_call")
}

/// Monthly budget state per scope. alert80SentAt guarantees exactly one 80 % alert per month.
model BudgetMonth {
  id             String      @id @default(cuid())
  scope          BudgetScope
  month          String // "2026-11" (Europe/Copenhagen)
  limitDkk       Decimal     @db.Decimal(12, 2)
  spentDkk       Decimal     @default(0) @db.Decimal(12, 4)
  alert80SentAt  DateTime?
  alert100SentAt DateTime?
  degradedAt     DateTime? // graceful degradation switched on
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([scope, month])
  @@map("budget_month")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Processed webhook ids (Stripe, Resend) for idempotency. Payload purged after 30 days.
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    WebhookProvider
  externalId  String // Stripe event.id / Resend svix-id
  type        String
  status      WebhookStatus   @default(RECEIVED)
  payload     Json?
  error       String?
  receivedAt  DateTime        @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([receivedAt])
  @@map("webhook_event")
}

/// Kill switches and runtime flags (cached ≤ 60 s). Env vars are fallback only.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // CONTENT_PIPELINE_ENABLED, CONTENT_AUTOPUBLISH_ENABLED, AI_DEGRADED_MODE, …
  enabled     Boolean  @default(false)
  value       Json?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flag")
}

/// The learner's own choice to bring passed modules and certificates from one of their accounts into another
/// (private → company when joining, company → private when leaving). One decision per (user, from, to); logged.
model CredentialTransfer {
  id                 String                     @id @default(cuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromOrganizationId String // no FK: the source account may be deleted later
  toOrganizationId   String
  toOrganization     Organization               @relation(fields: [toOrganizationId], references: [id], onDelete: Cascade)
  decision           CredentialTransferDecision
  modulesCarried     Int                        @default(0)
  certificatesShared Int                        @default(0)
  decidedAt          DateTime                   @default(now())

  @@unique([userId, fromOrganizationId, toOrganizationId])
  @@index([toOrganizationId])
  @@map("credential_transfer")
}

/// A certificate issued in another account that the holder chose to show in this organization.
/// The certificate itself is never re-issued: same code, date and content version.
model CertificateShare {
  id             String       @id @default(cuid())
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([certificateId, organizationId])
  @@index([organizationId])
  @@map("certificate_share")
}

// ───────────────────────── Connector recommendations (branche → opgaver → systemer → connectors) ─────────────────────────
// All mapping is data (content/connectors/*.json, seeded); the scoring in src/server/connectors/scoring.ts is pure.

enum IndustryCodeSystem {
  DB25 // Dansk Branchekode 2025 (CVR since 1 Jan 2025)
  DB07
}

enum ConnectorPlatform {
  CLAUDE
  CHATGPT
  COPILOT
}

enum AvailabilityStatus {
  OFFICIAL
  THIRD_PARTY
  NONE
  UNVERIFIED // never shown as a recommendation
}

/// User-friendly industry ("Revision & regnskab"). Raw codes never reach the UI.
model Industry {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  codes        IndustryCode[]
  tasks        IndustryTask[]
  systems      IndustrySystem[]
  useCases     IndustryConnectorUseCase[]
  demos        ConnectorDemo[]
  workProfiles WorkProfile[]

  @@map("industry")
}

/// Official code prefix → Industry. Longest prefix wins (src/server/connectors/industry-match.ts).
model IndustryCode {
  id         String             @id @default(cuid())
  system     IndustryCodeSystem
  prefix     String // digits only
  industryId String
  industry   Industry           @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([system, prefix])
  @@map("industry_code")
}

model Task {
  id         String          @id @default(cuid())
  slug       String          @unique
  name       String
  industries IndustryTask[]
  connectors ConnectorTask[]

  @@map("task")
}

model IndustryTask {
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  weight     Int // 1–5

  @@id([industryId, taskId])
  @@map("industry_task")
}

model SystemCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  systems   System[]

  @@map("system_category")
}

/// A business system people use (e-conomic, Microsoft 365, Shopify …).
model System {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  categoryId String
  category   SystemCategory    @relation(fields: [categoryId], references: [id])
  industries IndustrySystem[]
  connectors ConnectorSystem[]

  @@map("system")
}

model IndustrySystem {
  industryId  String
  industry    Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  systemId    String
  system      System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  preselected Boolean  @default(false)

  @@id([industryId, systemId])
  @@map("industry_system")
}

model Connector {
  id           String                     @id @default(cuid())
  slug         String                     @unique
  name         String
  category     String
  systems      ConnectorSystem[]
  tasks        ConnectorTask[]
  availability ConnectorAvailability[]
  useCases     IndustryConnectorUseCase[]
  demos        ConnectorDemo[]

  @@map("connector")
}

model ConnectorSystem {
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  systemId    String
  system      System    @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([connectorId, systemId])
  @@map("connector_system")
}

model ConnectorTask {
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([connectorId, taskId])
  @@map("connector_task")
}

/// Connector × platform. OFFICIAL/THIRD_PARTY only with a source URL from the vendor's own catalogue.
model ConnectorAvailability {
  id             String             @id @default(cuid())
  connectorId    String
  connector      Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  platform       ConnectorPlatform
  status         AvailabilityStatus
  sourceUrl      String?
  lastVerifiedAt DateTime?
  note           String?

  @@unique([connectorId, platform])
  @@map("connector_availability")
}

model IndustryConnectorUseCase {
  industryId  String
  industry    Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  text        String

  @@id([industryId, connectorId])
  @@map("industry_connector_use_case")
}

/// "Prøv den": fictional input data + Danish example prompt. industryId null = generic demo.
model ConnectorDemo {
  id          String             @id @default(cuid())
  slug        String             @unique
  connectorId String
  connector   Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  industryId  String?
  industry    Industry?          @relation(fields: [industryId], references: [id], onDelete: Cascade)
  title       String
  data        Json // fictional mails, invoices, calendar … shown to the user and sent to the model
  prompt      String
  outputKind  String
  runs        ConnectorDemoRun[]

  @@index([connectorId, industryId])
  @@map("connector_demo")
}

/// One demo run (which connectors get tried most). The prompt text is not stored; tokens/cost live in AiCall.
model ConnectorDemoRun {
  id             String            @id @default(cuid())
  demoId         String
  demo           ConnectorDemo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  connectorId    String
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       ConnectorPlatform
  promptEdited   Boolean           @default(false)
  status         String // OK | BLOCKED_* | ERROR
  createdAt      DateTime          @default(now())

  @@index([connectorId, createdAt])
  @@map("connector_demo_run")
}

/// The learner's work profile in one organization: industry, optional CVR and the systems they use.
model WorkProfile {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryId         String?
  industry           Industry?           @relation(fields: [industryId], references: [id], onDelete: SetNull)
  cvr                String?
  companyName        String?
  industryCode       String?
  industryCodeSystem IndustryCodeSystem?
  selectedSystemIds  String[]            @default([])
  completedAt        DateTime?
  skippedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, userId])
  @@map("work_profile")
}

/// CVR lookups (only name + main industry code), 30-day TTL. Provider behind CompanyLookupProvider.
model CompanyLookupCache {
  id        String   @id @default(cuid())
  cvr       String   @unique
  provider  String
  payload   Json
  fetchedAt DateTime @default(now())

  @@map("company_lookup_cache")
}

// ───────────────────────────── Forløb (courses) ─────────────────────────────
// Step-by-step courses per tool (ChatGPT, Claude, Copilot): levels → modules → lessons, plus a test per level.
// Separate from Module/ModuleVersion on purpose: those feed the module catalog, placement plans, monthly packages and
// the content engine; course modules must not appear there. Content comes from content/forloeb/forloeb.json via
// `pnpm db:seed:forloeb` (idempotent upserts on the JSON ids, stored in `slug`). Additive tables only.

/// "klar" = can be opened; "kommer-snart" = visible, greyed out, cannot be opened. Unlocked per row without code changes.
enum CourseContentStatus {
  READY       @map("klar")
  COMING_SOON @map("kommer-snart")
}

model Course {
  id         String              @id @default(cuid())
  slug       String              @unique // JSON id, also the URL segment: /forloeb/<slug>
  trackId    String
  track      Track               @relation(fields: [trackId], references: [id])
  toolName   String // "ChatGPT" — text only, never a logo
  toolUrl    String
  headline   String
  disclaimer String
  status     CourseContentStatus @default(COMING_SOON)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  levels      CourseLevel[]
  completions CourseLessonCompletion[]

  @@index([trackId])
  @@map("course")
}

model CourseLevel {
  id        String   @id @default(cuid())
  slug      String   @unique
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nr        Int
  name      String // "Grøn"
  title     String
  outcome   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules CourseModule[]
  test    CourseTest?

  @@index([courseId, sortOrder])
  @@map("course_level")
}

model CourseModule {
  id          String              @id @default(cuid())
  slug        String              @unique
  levelId     String
  level       CourseLevel         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  nr          Int
  title       String
  description String
  status      CourseContentStatus @default(COMING_SOON)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lessons CourseLesson[]

  @@index([levelId, sortOrder])
  @@map("course_module")
}

model CourseLesson {
  id        String              @id @default(cuid())
  slug      String              @unique
  moduleId  String
  module    CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  nr        String // "1.1"
  title     String
  minutes   Int
  badges    String[]            @default([]) // shown in JSON order
  status    CourseContentStatus @default(COMING_SOON)
  content   Json? // { know, tryIt, quiz } — only for READY lessons; validated by src/lib/schemas/course.ts
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  completions CourseLessonCompletion[]

  @@index([moduleId, sortOrder])
  @@map("course_lesson")
}

/// One test after each level. The questions come later; only title/description/time/pass mark for now.
model CourseTest {
  id          String              @id @default(cuid())
  slug        String              @unique
  levelId     String              @unique
  level       CourseLevel         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title       String
  description String
  minutes     Int
  passPercent Int                 @default(80)
  status      CourseContentStatus @default(COMING_SOON)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("course_test")
}

/// A lesson is completed when its check question was answered correctly. Per user, per org (like Assignment), per course.
model CourseLessonCompletion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())

  @@unique([organizationId, userId, lessonId])
  @@index([organizationId, userId, courseId])
  @@map("course_lesson_completion")
}

/// Kalender (/kalender): the learner's own planned blocks. Completed lessons and øvemiljø sessions are computed, not stored.
enum CalendarEventType {
  LESSON // "Lektion"
  PRACTICE // "Øvelse"
  MEETING // "Holdmøde"
}

model CalendarEvent {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String            @db.VarChar(120)
  type           CalendarEventType
  startsAt       DateTime
  endsAt         DateTime // > startsAt, at most 12 h later (enforced in src/lib/schemas/calendar.ts)
  href           String? // internal path only
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, startsAt])
  @@index([organizationId])
  @@map("calendar_event")
}
